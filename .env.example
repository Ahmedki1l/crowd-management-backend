# Camera-Based Analytics — environment variables (copy to .env; never commit .env).
# See HLD Section 12.4.

# --- Datastore (SQL Server in production) -----------------------------------
# SQL Server:  mssql+pyodbc://sa:Password123@db:1433/camera_analytics?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# SQLite (dev): sqlite:///./camera_analytics.db
DATABASE_URL=sqlite:///./camera_analytics.db

# --- Optional shared cache / pub-sub (scaled-out workers) -------------------
REDIS_URL=

# --- API auth ----------------------------------------------------------------
# JWT/HS256 signing secret, or the static API key when auth_scheme=api_key.
API_AUTH_SECRET=change-me-in-production

# --- Camera credential encryption -------------------------------------------
# AES-256-GCM key: url-safe base64 of 32 bytes. REQUIRED.
# Generate: python -c "from app.services.credentials import CredentialCipher; print(CredentialCipher.generate_key())"
CAMERA_CREDENTIALS_KEY=

# Dedicated shared token used only by the HLS camera relay's internal
# credential lookup. Use the same value as CROWD_CAMERA_INTERNAL_TOKEN on the relay.
CROWD_CAMERA_INTERNAL_TOKEN=

# --- Model artifact locations (override config.yaml) ------------------------
MODEL_DETECTOR_PATH=models/detector
MODEL_REID_PATH=models/reid

# --- Misc --------------------------------------------------------------------
CONFIG_PATH=config/config.example.yaml
LOG_LEVEL=INFO
